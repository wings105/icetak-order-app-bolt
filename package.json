{
  "name": "html-static-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "check:acrylic-production": "node --experimental-strip-types scripts/check-acrylic-production.mjs",
    "dev": "vite",
    "check:admin-v2": "node scripts/check-admin-v2-source.mjs",
    "check:stock-admin": "node scripts/check-stock-admin.mjs",
    "check:whatsapp-optout": "node scripts/check-whatsapp-order-optout-guards.mjs",
    "check:order-id-forward": "node scripts/check-whatsapp-order-id-forward.mjs",
    "build": "npm run check:admin-v2 && vite build",
    "preview": "vite preview",
    "check:ai-dashboard": "node --experimental-strip-types scripts/check-ai-dashboard.mjs",
    "build:inbox": "npm --prefix apps/inbox ci --include=dev && npm --prefix apps/inbox run build",
    "check:product-catalog": "node --experimental-strip-types scripts/check-product-catalog.mjs",
    "check:task-workspace": "node --experimental-strip-types scripts/check-task-workspace.mjs",
    "check:task-readiness": "node --experimental-strip-types scripts/check-task-readiness.mjs",
    "check:detail-automation": "node --experimental-strip-types scripts/check-detail-automation.mjs",
    "check:shopee-cards": "node --experimental-strip-types scripts/check-shopee-cards.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@supabase/supabase-js": "^2.51.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "lucide": "^0.469.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.180.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "4.145.0"
  }
}
